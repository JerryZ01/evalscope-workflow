# ============================================================
# EvalScope Workflow — Environment Variables Template
# 用法: cp .env.example .env  并按需修改
# ============================================================

# -------- 端口映射 (宿主侧) --------
FRONTEND_PORT=5801
BACKEND_PORT=5900

# -------- 后端应用配置 --------
APP_NAME=EvalScope Workflow
DEBUG=false

# 本地开发路径；Docker Compose 会覆盖为 /app/data/db 下的持久化路径
DATABASE_URL=sqlite+aiosqlite:///./evalscope.db
WORKFLOW_CHECKPOINT_DB=./evalscope_checkpoints.db
SETTINGS_FILE=./settings.json

# Redis（Celery 后台任务，当前未启用，留空保留兼容）
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# EvalScope 本地开发目录；Docker Compose 会覆盖为 /app 下的持久化路径
EVALSCOPE_DATASET_DIR=./data/datasets
EVALSCOPE_WORK_DIR=./data/work
EVALSCOPE_USE_CACHE=true

# CORS 允许的来源（生产环境建议改成具体域名，例如：https://eval.your-domain.com）
CORS_ORIGINS='["http://localhost:5801","http://127.0.0.1:5801"]'

# 共享令牌留空时不启用登录保护；公网部署必须设置强随机值
API_AUTH_TOKEN=
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=86400

# -------- Langfuse 可观测性 --------
# 填入实际值后 Langfuse 自动启用，留空则跳过
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
