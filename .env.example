# ============================================================
# EvalScope Workflow — Environment Variables Template
# 用法: cp .env.example .env  并按需修改
# ============================================================

# -------- 端口映射 (宿主侧) --------
FRONTEND_PORT=5801
BACKEND_PORT=5900
# 仅本地 Vite 开发服务器使用
VITE_BACKEND_TARGET=http://localhost:5900

# -------- 后端应用配置 --------
APP_NAME=EvalScope Workflow
DEBUG=false

# 数据库（容器内路径；通过 volume 持久化到 ./data/db）
DATABASE_URL=sqlite+aiosqlite:////app/data/db/evalscope.db

# Redis（Celery 后台任务，当前未启用，留空保留兼容）
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# EvalScope 工作目录（容器内路径；通过 volume 持久化）
EVALSCOPE_DATASET_DIR=/app/data/datasets
EVALSCOPE_WORK_DIR=/app/outputs
EVALSCOPE_USE_CACHE=true
WORKFLOW_CHECKPOINT_DB=/app/data/db/evalscope_checkpoints.db
SETTINGS_FILE=/app/data/db/settings.json

# CORS 允许的来源（生产环境建议改成具体域名，例如：https://eval.your-domain.com）
CORS_ORIGINS=["*"]

# 可选共享访问令牌。生产环境必须设置强随机值；留空则关闭鉴权。
API_AUTH_TOKEN=
# HTTPS 部署时设为 true，确保认证 Cookie 仅通过 TLS 发送。
SESSION_COOKIE_SECURE=false

# -------- Langfuse 可观测性 --------
# 填入实际值后 Langfuse 自动启用，留空则跳过
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
